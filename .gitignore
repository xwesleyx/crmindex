# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# prisma (sqlite local dev database)
/prisma/*.db
/prisma/*.db-*
/prisma/*.db-journal

# typescript
*.tsbuildinfo
next-env.d.ts

# whatsapp-service (Python — venv e sessão do WhatsApp nunca vão pro git)
/whatsapp-service/venv/
/whatsapp-service/__pycache__/
/whatsapp-service/*.db
/whatsapp-service/*.db-*
/whatsapp-service/media/
/whatsapp-service/service.log

# claude code (config local da máquina, não do projeto)
/.claude/settings.local.json
/.claude/scheduled_tasks.lock

# instalador Windows (installer/build.ps1)
/.next-installer/
/installer/.build/
/installer/output/

# cache local de fotos de contato do Atendimento (recriado sozinho)
/.cache/

# backups do CRM (Configurações > Backup) no desenvolvimento
/backups

# modelos de configuração (só valores de exemplo, sem segredos)
!.env.example
