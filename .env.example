# Banco de dados (PostgreSQL — Render ou outro Postgres acessível)
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Auth.js — gerar com: npx auth secret (ou: openssl rand -base64 32)
AUTH_SECRET=""

# Seed do primeiro administrador (usados apenas por `npm run db:seed`, nunca em código)
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME="Administrador"

# WhatsApp — a API (manual / neonize / whatsapp_cloud) é escolhida em
# Configurações > Integrações; WHATSAPP_PROVIDER aqui só vale enquanto nada
# foi escolhido pela tela. Neonize usa o whatsapp-service/ (ver README dessa
# pasta); a API oficial da Meta é configurada inteira pela tela.
WHATSAPP_PROVIDER="manual"
WHATSAPP_SERVICE_URL="http://localhost:8787"
WHATSAPP_SERVICE_SECRET=""

# Prospecção de CNPJ (CRM > Prospecção CNPJ) — busca empresas novas por
# cidade/UF/período via CFO.com.br (dados abertos da Receita Federal).
# Crie a conta em https://cfo.com.br, gere uma API key e cole aqui. Deixe em
# branco pra manter a tela desabilitada.
CFO_API_KEY=""
CFO_API_URL="https://cfo.com.br/api"
