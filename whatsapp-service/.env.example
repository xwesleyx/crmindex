# URL do webhook do CRM (Next.js) que recebe as mensagens do WhatsApp.
NEXTJS_WEBHOOK_URL="http://localhost:3000/api/webhooks/whatsapp"

# Segredo compartilhado — o MESMO valor precisa estar em WHATSAPP_SERVICE_SECRET
# no .env do Next.js. Gere com: openssl rand -hex 32
WEBHOOK_SECRET=""

# Nome/arquivo da sessão do WhatsApp (fica salvo nesta pasta, nunca vai pro
# git). Trocar o nome = nova sessão = precisa escanear o QR de novo. Em
# produção (Render), use um caminho absoluto dentro do disco persistente,
# ex.: "/data/integra-crm.db" — sem isso, a sessão some a cada deploy e pede
# QR de novo toda vez.
SESSION_NAME="integra-crm.db"

# Em produção (Render), aponte pra dentro do disco persistente, ex.:
# "/data/media" — sem isso, as mídias recebidas somem a cada deploy. Em
# dev, deixe em branco (usa a pasta "media" ao lado deste arquivo).
MEDIA_DIR=""

# URL pela qual QUALQUER navegador enxerga este serviço (não só o desta
# máquina) — usada para montar o link de foto/vídeo/áudio/figurinha salvo no
# CRM. Se não definir, cai no padrão "http://localhost:8787", que só carrega
# mídia no computador que está rodando este serviço; outros computadores da
# rede veem a mensagem, mas não a mídia. Use o IP local desta máquina na
# rede (ex: "http://192.168.0.10:8787") ou um domínio, se tiver.
PUBLIC_URL=""
